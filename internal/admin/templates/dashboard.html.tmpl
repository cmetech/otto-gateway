{{define "content"}}
<main class="gw-page">

  <!-- Section 1: Summary header strip (Plan 01 — fully populated) -->
  <section class="gw-summary-strip" aria-labelledby="summary-heading">
    <h1 id="summary-heading" class="sr-only">Gateway status overview</h1>

    <!-- All 7 stat tiles live in one grid wrapper so they render as a
         single even row (or a 4+3 split on narrower viewports) instead of
         flex-wrapping one orphan tile onto a second line. -->
    <div class="gw-summary-items">

    <!-- Status pill -->
    <div class="gw-summary-item">
      <span class="gw-summary-label">Status</span>
      <span class="gw-summary-value"><span class="gw-status-pill" data-pill>—</span></span>
    </div>

    <!-- Uptime -->
    <div class="gw-summary-item">
      <span class="gw-summary-label">Uptime</span>
      <span class="gw-summary-value" data-uptime>—</span>
    </div>


    <!-- Debug logging enablement (baked in at render time — does not poll).
         Chip semantics: green = on, gray = off. -->
    <div class="gw-summary-item">
      <span class="gw-summary-label">Debug</span>
      <span class="gw-summary-value"><span class="gw-pill {{if .Debug}}gw-pill-on{{else}}gw-pill-off{{end}}">{{if .Debug}}on{{else}}off{{end}}</span></span>
    </div>

    <!-- Chat-trace enablement (baked in at render time — does not poll).
         SENSITIVE: when on, raw prompts are written to disk. Surfaced as a
         safety affordance so operators are not surprised by it — hence the
         AMBER (warning) chip when on, matching the About page's SENSITIVE
         badge, rather than green. -->
    <div class="gw-summary-item">
      <span class="gw-summary-label">Chat-trace</span>
      <span class="gw-summary-value"><span class="gw-pill {{if .ChatTrace}}gw-pill-warn{{else}}gw-pill-off{{end}}">{{if .ChatTrace}}on{{else}}off{{end}}</span></span>
    </div>

    <!-- Compression EFFECTIVE posture (baked in at render time — does not
         poll). THREE states: "on" (green) = hook in chain AND
         COMPRESSION_ENABLED=true; "per-request" (purple) = hook in chain
         but env default off — the X-Compression header or a +compress
         model suffix still enables individual requests; "off" (gray) =
         CompressionHook excluded by an explicit ENABLED_HOOKS allowlist,
         so NO request can compress. -->
    <div class="gw-summary-item">
      <span class="gw-summary-label">Compression</span>
      <span class="gw-summary-value">{{if eq .CompressionState "on"}}<span class="gw-pill gw-pill-on">on</span>{{else if eq .CompressionState "per-request"}}<span class="gw-pill gw-pill-req" title="Off by default; the X-Compression header or a +compress model suffix enables it per request">per-request</span>{{else}}<span class="gw-pill gw-pill-off" title="CompressionHook is not in the ENABLED_HOOKS allowlist — no request can compress">off</span>{{end}}</span>
    </div>

    <!-- Gateway process CPU (hydrated by JS; live percent derived from the
         cumulative process_cpu_seconds counter across polls). "n/a" on
         platforms where the read is unavailable (e.g. darwin dev box). -->
    <div class="gw-summary-item gw-summary-perf">
      <span class="gw-summary-label">Gateway CPU</span>
      <span class="gw-perf-inline">
        <span class="gw-summary-value" data-gw-cpu>—</span>
        <span class="gw-spark-host" data-gw-cpu-spark></span>
      </span>
    </div>

    <!-- Gateway process resident memory (RSS / working set), hydrated by JS. -->
    <div class="gw-summary-item gw-summary-perf">
      <span class="gw-summary-label">Gateway Mem</span>
      <span class="gw-perf-inline">
        <span class="gw-summary-value" data-gw-mem>—</span>
        <span class="gw-spark-host" data-gw-mem-spark></span>
      </span>
    </div>

    </div>

    <!-- Live indicator zone (right-aligned) -->
    <div class="gw-live-zone">
      <div class="gw-live-row">
        <span class="gw-live-dot" data-live-dot></span>
        <span class="gw-last-updated" data-last-updated>Loading…</span>
      </div>
    </div>
  </section>

  <!-- Section 2: Pool Slots grid (Plan 02 fills the cards) -->
  <section aria-labelledby="pool-slots-heading">
    <h2 id="pool-slots-heading" class="gw-h2">Pool Slots</h2>
    <div class="gw-slot-grid" data-slot-grid></div>
    <div class="gw-slot-grid-empty" data-slot-grid-empty hidden>No pool slots configured (set POOL_SIZE)</div>
  </section>

  <!-- Section 3: Active Sessions table (Plan 02 fills) -->
  <section aria-labelledby="active-sessions-heading">
    <h2 id="active-sessions-heading" class="gw-h2">Active Sessions</h2>
    <div class="gw-sessions-card" data-sessions-card>
      <table class="gw-sessions-table" data-sessions-table>
        <thead>
          <tr>
            <th>Session</th>
            <th>Status</th>
            <th>Last used</th>
            <th>Model</th>
          </tr>
        </thead>
        <tbody data-sessions-tbody></tbody>
      </table>
      <div class="gw-empty-state" data-sessions-empty hidden>
        <strong>No active sessions</strong>
        <p>Stateful sessions created via the X-Session-Id header will appear here.</p>
      </div>
    </div>
  </section>

  <section id="model-catalog" class="gw-card gw-model-catalog" aria-labelledby="model-catalog-heading">
    <header class="gw-model-catalog-header">
      <div class="gw-model-catalog-title">
        <p class="gw-eyebrow">Live capability inventory</p>
        <h2 id="model-catalog-heading" class="gw-h2">Model Catalog</h2>
        <p class="gw-model-catalog-intro">Selectable models published by the active gateway workers.</p>
      </div>
      <div class="gw-model-catalog-operator">
        <dl class="gw-model-catalog-meta" aria-label="Model catalog status">
          <div><dt>Status</dt><dd><span class="gw-badge is-muted" data-model-catalog-state>Loading</span></dd></div>
          <div><dt>Models</dt><dd data-model-catalog-count>—</dd></div>
          <div><dt>Last success</dt><dd data-model-catalog-last-success>—</dd></div>
          <div><dt>Next attempt</dt><dd data-model-catalog-next>—</dd></div>
          <div><dt>Interval</dt><dd data-model-catalog-interval>—</dd></div>
        </dl>
        <button type="button" class="gw-btn gw-btn--primary gw-model-catalog-refresh" data-model-catalog-refresh aria-busy="false">Refresh now</button>
      </div>
    </header>

    <p class="gw-model-catalog-message" data-model-catalog-message hidden></p>
    <p class="sr-only" data-model-catalog-live aria-live="polite" aria-atomic="true"></p>

    <div class="gw-model-catalog-scroll" role="region" aria-labelledby="model-catalog-heading" tabindex="0">
      <table class="gw-model-catalog-table">
        <caption class="sr-only">Live selectable model catalog and capabilities</caption>
        <thead>
          <tr>
            <th scope="col">Model</th>
            <th scope="col">Model ID</th>
            <th scope="col">Completion</th>
            <th scope="col">Tools</th>
            <th scope="col">Vision</th>
            <th scope="col">Reasoning</th>
          </tr>
        </thead>
        <tbody data-model-catalog-body></tbody>
      </table>
    </div>
  </section>

  <section class="gw-card gw-privacy-console" aria-labelledby="privacy-boundary-heading">
    <div class="gw-section-heading-row">
      <div>
        <p class="gw-eyebrow">Policy boundary</p>
        <h2 id="privacy-boundary-heading" class="gw-h2">Privacy Boundary</h2>
      </div>
      <a class="gw-help-link" href="/admin/privacy">Status &amp; configuration reference <span aria-hidden="true">→</span></a>
    </div>
    <dl class="gw-privacy-status-grid">
      <div><dt>Default profile</dt><dd data-privacy-default-profile>—</dd></div>
      <div><dt>Strict requests</dt><dd><span class="gw-badge is-muted" data-privacy-strict>—</span></dd></div>
      <div><dt>Protected</dt><dd data-privacy-protected>—</dd></div>
      <div><dt>Blocked</dt><dd data-privacy-blocked>—</dd></div>
      <div><dt>Active scopes</dt><dd data-privacy-scopes>—</dd></div>
      <div><dt>In flight</dt><dd data-privacy-in-flight>—</dd></div>
      <div><dt>Entries</dt><dd data-privacy-entries>—</dd></div>
      <div><dt>Per-scope limit</dt><dd data-privacy-per-scope>—</dd></div>
      <div><dt>Scope TTL</dt><dd data-privacy-ttl>—</dd></div>
      <div><dt>Oldest scope</dt><dd data-privacy-oldest>—</dd></div>
      <div><dt>Triage</dt><dd><span class="gw-badge is-muted" data-privacy-triage>—</span></dd></div>
      <div><dt>Last error</dt><dd><code data-privacy-last-error>—</code></dd></div>
    </dl>
    <p class="gw-privacy-footnote">Counts are since process start. Limits use current / maximum values.</p>
  </section>

  <!-- Section 4: Log Tail panel (Plan 03 — SSE live tail) -->
  <section aria-labelledby="log-tail-heading">
    <h2 id="log-tail-heading" class="gw-h2">Log Tail</h2>
    <div class="gw-log-panel">

      <!-- Activity header row: pulsing dot + connection status text -->
      <div class="gw-log-header">
        <span class="gw-live-dot gw-log-activity-dot" data-log-activity></span>
        <span class="gw-log-status" data-log-status>Connecting…</span>
      </div>

      <!-- Control row: source dropdown, level filter, regex grep, pause/resume, newest badge -->
      <div class="gw-log-controls">
        <!-- Source selector (quick 260529-ll2). Populated from
             /admin/api/snapshot's log_sources field on the first poll;
             switching source closes the existing SSE stream and opens
             a new one against /admin/logs/stream?source=<name>. -->
        <select class="gw-select" data-log-source aria-label="Log file"></select>
        <select class="gw-select" data-log-level aria-label="Log level filter">
          <option value="all">All levels</option>
          <option value="debug">Debug</option>
          <option value="info">Info</option>
          <option value="warn">Warn</option>
          <option value="error">Error</option>
        </select>
        <input class="gw-input" type="text" placeholder="Filter lines (regex)…"
               data-log-grep aria-label="Filter lines">
        <span class="gw-grep-hint" data-log-grep-hint hidden>Invalid regex — filter not applied</span>
        <button class="gw-btn" type="button" data-log-pause>Pause</button>
        <span class="gw-newest-badge" data-log-newest hidden></span>
      </div>

      <!-- Log viewport: 4-column grid, fixed-height, scrollable, aria-live.
           Header row is rendered ONCE here and stays sticky as rows scroll;
           appendLine() in admin.js builds .gw-log-row / .gw-log-row-fallback
           children inside this same viewport. data-log-viewport remains on the
           OUTER scroll container so document.querySelector('[data-log-viewport]')
           keeps working unchanged. -->
      <div class="gw-log-viewport" data-log-viewport
           role="log" aria-live="polite" aria-relevant="additions">
        <div class="gw-log-header-row">
          <div class="gw-log-cell gw-log-cell-time">Time</div>
          <div class="gw-log-cell gw-log-cell-level">Level</div>
          <div class="gw-log-cell gw-log-cell-source">Source</div>
          <div class="gw-log-cell gw-log-cell-message">Message</div>
        </div>
        <div class="gw-log-empty" data-log-empty>Checking log source…</div>
      </div>

    </div>
  </section>

  <!-- Section 5: ACP Capture (diagnostics) — hidden until admin.js confirms availability -->
  <section aria-labelledby="acp-capture-heading" data-acp-capture hidden>
    <h2 id="acp-capture-heading" class="gw-h2">ACP Capture (diagnostics)</h2>
    <div class="gw-acp-capture-card">
      <span class="gw-pill" data-acp-capture-pill>—</span>
      <span data-acp-capture-count>0 / 0 frames</span>
      <span class="gw-acp-capture-controls" data-acp-capture-controls hidden>
        <!-- Both toggle icons ship in the markup; the is-on/is-off class set by
             admin.js drives which one CSS reveals (same convention as the
             header theme toggle's sun/moon pair). -->
        <button type="button" class="gw-btn gw-btn--icon gw-acp-capture-toggle is-off" data-acp-capture-toggle>
          <svg class="icon-enable" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 0 1 0 .656l-5.603 3.113a.375.375 0 0 1-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112Z"/></svg>
          <svg class="icon-disable" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 0 1 9 14.437V9.564Z"/></svg>
          <span data-acp-capture-toggle-label>Enable</span>
        </button>
        <button type="button" class="gw-btn gw-btn--icon" data-acp-capture-clear>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg>
          <span>Clear</span>
        </button>
      </span>
      <!-- Opens the capture ring in a new tab, server-side indented (?pretty=1)
           so the frames are readable without a JSON viewer extension. -->
      <a class="gw-btn gw-btn--icon" href="/admin/api/acp-capture?pretty=1" target="_blank" rel="noopener"
         title="Open the raw captured ACP messages (pretty-printed JSON) in a new tab" data-acp-capture-raw>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z"/></svg>
        <span>Show Messages</span>
      </a>
      <p class="gw-acp-capture-note" data-acp-capture-note hidden>
        Read-only: start the gateway with <code>ACP_CAPTURE_RUNTIME=true</code> to toggle here.
      </p>
    </div>
  </section>

</main>

<!-- Config island: bakes in version/commit at render time; pollMs is the
     JS polling cadence (30s fixed per D-06). The `js` filter escapes both
     fields for safe <script> context (html/template T-6.1-01 mitigation). -->
<script>window.GW_ADMIN_CONFIG = { version: {{.Version | js}}, commit: {{.Commit | js}}, pollMs: 30000 };</script>
<script src="/admin/static/js/admin.js"></script>
{{end}}
{{template "base" .}}
